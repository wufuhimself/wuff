# Magic-link login (Resend). Without RESEND_API_KEY, /login prints the link
# to the server console instead of emailing it — fine for local dev, not for
# a real deploy (users would never receive their login link).
RESEND_API_KEY=your_resend_api_key_here
# Optional: verified sender address once you own a domain in Resend. Until
# then the shared onboarding@resend.dev sender works with zero setup.
WUFF_MAIL_FROM=wuff <onboarding@resend.dev>

# Flask session/token signing secret. Login tokens (magic links) and cookie
# encryption (app/crypto.py, if WUFF_ENCRYPTION_KEY is unset) both derive
# from this — set a real random value for any deploy, never the dev default.
SECRET_KEY=dev-only-not-a-secret

# Yahoo OAuth credentials (required)
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here
YAHOO_REDIRECT_URI=https://localhost:3000/oauth/callback
YAHOO_LEAGUE_ID=your_league_id_here
YAHOO_TEAM_KEY=your_team_key_here

# SSL certificate paths (optional, for OAuth callback)
# If not set, the app will auto-generate self-signed certificates at runtime
YAHOO_SSL_KEY_PATH=./certs/localhost.key
YAHOO_SSL_CERT_PATH=./certs/localhost.crt
