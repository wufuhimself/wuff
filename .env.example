# Yahoo OAuth credentials (required)
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here
YAHOO_REDIRECT_URI=https://localhost:3000/oauth/callback
YAHOO_LEAGUE_ID=your_league_id_here
YAHOO_TEAM_KEY=your_team_key_here

# SSL certificate paths (optional, for OAuth callback)
# If not set, the app will auto-generate self-signed certificates at runtime
YAHOO_SSL_KEY_PATH=./certs/localhost.key
YAHOO_SSL_CERT_PATH=./certs/localhost.crt
